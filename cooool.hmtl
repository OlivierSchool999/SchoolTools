<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <title>Dash & Dot Web Bluetooth Controller</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 650px;
      margin: 30px auto;
      padding: 20px;
      background: #f4f7f9;
      color: #222;
    }
    h1 { margin-top: 0; color: #0077cc; }
    .card {
      background: white;
      padding: 18px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      margin-bottom: 16px;
    }
    button {
      background: #0077cc;
      color: white;
      border: none;
      padding: 10px 14px;
      margin: 4px;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
    }
    button:hover { background: #005fa3; }
    button.stop { background: #d93025; font-weight: bold; }
    button.stop:hover { background: #b3241b; }
    button.connect { background: #188038; font-size: 16px; font-weight: bold; }
    .dpad {
      display: grid;
      grid-template-columns: repeat(3, 90px);
      gap: 6px;
      justify-content: center;
      margin: 10px 0;
    }
    .dpad button { width: 90px; height: 50px; margin: 0; }
    input[type="text"] {
      padding: 9px;
      width: 240px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-family: monospace;
    }
    #status { font-weight: bold; margin-left: 10px; color: #555; }
  </style>
</head>
<body>

  <h1>🤖 Dash Controller</h1>

  <div class="card">
    <button class="connect" onclick="connectDash()">🔗 Verbind met Dash</button>
    <span id="status">Niet verbonden</span>
  </div>

  <div class="card">
    <h3>🚗 Rijden (of gebruik pijltjestoetsen)</h3>
    <div class="dpad">
      <div></div>
      <button onmousedown="drive(100, 100)" onmouseup="stopDrive()">⬆️ Vooruit</button>
      <div></div>
      <button onmousedown="drive(-70, 70)" onmouseup="stopDrive()">⬅️ Links</button>
      <button class="stop" onclick="stopDrive()">🛑 STOP</button>
      <button onmousedown="drive(70, -70)" onmouseup="stopDrive()">➡️ Rechts</button>
      <div></div>
      <button onmousedown="drive(-100, -100)" onmouseup="stopDrive()">⬇️ Achteruit</button>
      <div></div>
    </div>
  </div>

  <div class="card">
    <h3>👀 Hoofd bewegen</h3>
    <button onclick="send([0x06, 0x2d])">Links kijken</button>
    <button onclick="send([0x06, 0x00])">Recht vooruit</button>
    <button onclick="send([0x06, 0xd3])">Rechts kijken</button>
    <button onclick="send([0x07, 0xf0])">Omhoog</button>
    <button onclick="send([0x07, 0x05])">Omlaag</button>
  </div>

  <div class="card">
    <h3>💡 Lampjes</h3>
    <button onclick="send([0x0b, 0xff, 0x00, 0x00])">Oren Rood</button>
    <button onclick="send([0x0b, 0x00, 0xff, 0x00])">Oren Groen</button>
    <button onclick="send([0x0b, 0x00, 0x00, 0xff])">Oren Blauw</button>
    <button onclick="send([0x03, 0xff, 0x00, 0xff])">Borst Paars</button>
    <button onclick="send([0x08, 0xff])">Ogen Aan</button>
    <button onclick="send([0x08, 0x00])">Ogen Uit</button>
  </div>

  <div class="card">
    <h3>🔊 Geluiden</h3>
    <button onclick="send([0x18, 0x53, 0x59, 0x5f, 0x48, 0x49, 0x00])">Zeg "Hi!"</button>
    <button onclick="send([0x18, 0x53, 0x59, 0x5f, 0x42, 0x59, 0x45, 0x00])">Zeg "Bye!"</button>
    <button onclick="send([0x18, 0x53, 0x59, 0x5f, 0x4c, 0x41, 0x55, 0x47, 0x48, 0x00])">Lachen</button>
    <button onclick="send([0x18, 0x53, 0x59, 0x5f, 0x48, 0x4f, 0x52, 0x4e, 0x00])">Toeter</button>
  </div>

  <div class="card">
    <h3>🛠️ Zelf Hex-bytes sturen</h3>
    <input type="text" id="hexInput" placeholder="bijv. 0b ff 88 00" value="0b ff 88 00">
    <button onclick="sendCustom()">Verstuur</button>
  </div>

  <script>
    let cmdChar = null;
    const SERVICE_UUID = 'af237777-879d-6186-1f49-deca0e85d9c1';
    const CHAR_UUID    = 'af230002-879d-6186-1f49-deca0e85d9c1';

    async function connectDash() {
      try {
        const device = await navigator.bluetooth.requestDevice({
          acceptAllDevices: true,
          optionalServices: [SERVICE_UUID]
        });
        document.getElementById('status').textContent = 'Verbinden...';
        const server = await device.gatt.connect();
        const service = await server.getPrimaryService(SERVICE_UUID);
        cmdChar = await service.getCharacteristic(CHAR_UUID);
        document.getElementById('status').textContent = '✅ Verbonden met ' + device.name;
        document.getElementById('status').style.color = '#188038';
      } catch (err) {
        alert('Verbinden mislukt: ' + err);
        document.getElementById('status').textContent = 'Niet verbonden';
      }
    }

    async function send(bytes) {
      if (!cmdChar) return alert('Klik eerst op "Verbind met Dash"!');
      try {
        await cmdChar.writeValue(new Uint8Array(bytes));
      } catch (e) {
        console.error(e);
      }
    }

    function drive(left, right) {
      const l = left < 0 ? 256 + left : left;
      const r = right < 0 ? 256 + right : right;
      send([0x02, l, 0x00, r, 0x00]);
    }

    function stopDrive() {
      send([0x02, 0x00, 0x00, 0x00, 0x00]);
    }

    function sendCustom() {
      const raw = document.getElementById('hexInput').value.trim();
      if (!raw) return;
      const bytes = raw.split(/\s+/).map(h => parseInt(h, 16));
      send(bytes);
    }

    // Besturing met pijltjestoetsen
    let keyDown = false;
    document.addEventListener('keydown', (e) => {
      if (keyDown || document.activeElement.tagName === 'INPUT') return;
      if (e.key === 'ArrowUp')    { keyDown = true; drive(100, 100); }
      if (e.key === 'ArrowDown')  { keyDown = true; drive(-100, -100); }
      if (e.key === 'ArrowLeft')  { keyDown = true; drive(-70, 70); }
      if (e.key === 'ArrowRight') { keyDown = true; drive(70, -70); }
    });
    document.addEventListener('keyup', (e) => {
      if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)) {
        keyDown = false;
        stopDrive();
      }
    });
  </script>
</body>
</html>
